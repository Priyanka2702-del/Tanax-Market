# Path of the SQLite database file (created automatically on first run)
DATABASE_PATH=./data/tenex.db
# Where uploaded KYC documents are stored (kept OUTSIDE /public)
UPLOAD_DIR=./storage/kyc
# Public URL of the site (used in password-reset links)
APP_URL=http://localhost:3000
# Optional: transactional email through Resend (https://resend.com). Without these, reset links are printed to the server console.
RESEND_API_KEY=
MAIL_FROM="Tenex Market <no-reply@yourdomain.com>"
# Shown on the Trading Platforms page
MT5_SERVER=TenexMarket-Live
